; Файл настроек проекта Godot 4.x — TIMEPRICE.

config_version=5

[application]

config/name="TIMEPRICE"
config/description="Твои деньги. Твоё время. Твой выбор."
config/version="0.3.0"
run/main_scene="res://scenes/main/main.tscn"
run/low_processor_mode=true
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"
config/quit_on_go_back=false
boot_splash/bg_color=Color(0.0549, 0.0784, 0.1255, 1)
boot_splash/show_image=false

[autoload]

SettingsManager="*res://scripts/managers/settings_manager.gd"
DataManager="*res://scripts/managers/data_manager.gd"
NavigationManager="*res://scripts/managers/navigation_manager.gd"

[display]

window/size/viewport_width=400
window/size/viewport_height=860
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[internationalization]

locale/fallback="ru"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.0549, 0.0784, 0.1255, 1)
