static func category_name(key: String) -> String:
	return Loc.t(CATEGORY_NAMES.get(key, key))


static func by_category(key: String) -> Array:
	var out: Array = []
	for t in ITEMS:
		if t["category"] == key:
			out.append(t)
	return out


## Совет дня: меняется раз в сутки по дате устройства.
static func tip_of_day(unix_time: int) -> Dictionary:
	var bias: int = Time.get_time_zone_from_system().get("bias", 0)
	var day: int = (unix_time + bias * 60) / 86_400
	return ITEMS[posmod(day, ITEMS.size())]
